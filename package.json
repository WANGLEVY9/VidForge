{
  "name": "vidforge",
  "version": "1.0.0",
  "description": "电商场景AIGC带货视频生成系统",
  "license": "MIT",
  "homepage": "https://github.com/WANGLEVY9/VidForge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WANGLEVY9/VidForge.git"
  },
  "bugs": {
    "url": "https://github.com/WANGLEVY9/VidForge/issues"
  },
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.15.4",
  "scripts": {
    "dev": "pnpm --filter=@vidforge/frontend dev & pnpm --filter=@vidforge/backend start:dev",
    "build": "pnpm build:all",
    "build:backend": "pnpm --filter @vidforge/backend build",
    "build:frontend": "pnpm --filter @vidforge/frontend build",
    "check:bundle": "node scripts/check-bundle-size.js",
    "build:all": "pnpm build:frontend && pnpm build:backend",
    "check:env": "node scripts/check-env.js",
    "checkpointer:setup": "node scripts/setup-agent-checkpointer.mjs",
    "checkpointer:smoke": "node scripts/checkpointer-smoke.mjs",
    "check:hygiene": "node scripts/check-repo-hygiene.js",
    "benchmark:local": "node scripts/benchmark-local.mjs",
    "docs:check": "node scripts/check-markdown-links.js",
    "test:repo": "node --test scripts/*.test.js",
    "test:backend": "pnpm --filter @vidforge/backend test",
    "test": "pnpm test:repo && pnpm test:backend",
    "verify": "pnpm check:env && pnpm check:hygiene && pnpm docs:check && pnpm test && pnpm lint && pnpm stylelint && pnpm build && pnpm check:bundle",
    "start": "cd apps/backend && npm run start:prod",
    "lint": "pnpm --filter @vidforge/frontend lint && pnpm --filter @vidforge/backend lint",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "prettier": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prettier:fix": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "stylelint": "stylelint \"**/*.{css,less,scss}\"",
    "stylelint:fix": "stylelint \"**/*.{css,less,scss}\" --fix",
    "prepare": "husky"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "husky": "^9.0.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.3.3"
  },
  "pnpm": {
    "overrides": {
      "body-parser": "1.20.6",
      "brace-expansion": "2.1.4",
      "js-yaml": "4.3.1",
      "lodash": "4.18.0",
      "multer": "2.2.0",
      "qs": "6.15.2",
      "socket.io-parser": "4.2.7",
      "uuid": "11.1.1",
      "ws": "8.21.0"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,less,scss}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
