# =====================================================================
# VidForge Backend 环境变量样例（请复制为 .env 后填入真实值；不要提交真实 .env）
# 部署到 Railway 时，把下方所有变量配置到 Service → Variables 中。
# =====================================================================

# 运行环境
NODE_ENV=development
PORT=3001

# 前端地址（生产 CORS 白名单，多个域名用逗号分隔）
WEB_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------
# 数据库（PostgreSQL）
# 任选下面一种方式（推荐用 DATABASE_URL）
# ---------------------------------------------------------------------
DATABASE_URL=postgresql://username:password@localhost:5432/vidforge
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=vidforge

# 是否在启动时自动同步表结构（首次部署设为 true 建表，之后建议设回 false）
DB_SYNCHRONIZE=false

# ---------------------------------------------------------------------
# 火山方舟 ARK：文本模型（Doubao-Seed-2.0-pro）
# ---------------------------------------------------------------------
ARK_TEXT_PRIMARY_ENDPOINT_ID=ep-xxxxxxxxxxxxxx
ARK_TEXT_PRIMARY_API_KEY=REDACTED_ARK_API_KEY
ARK_TEXT_PRIMARY_NAME=Doubao-Seed-2.0-pro
ARK_TEXT_PRIMARY_RATE_LIMIT=100RPM 50WTPM

# ---------------------------------------------------------------------
# 火山方舟 ARK：视频模型（Doubao-Seedance-1.5-pro）
# ---------------------------------------------------------------------
ARK_VIDEO_PRIMARY_ENDPOINT_ID=ep-xxxxxxxxxxxxxx
ARK_VIDEO_PRIMARY_API_KEY=REDACTED_ARK_API_KEY
ARK_VIDEO_PRIMARY_NAME=Doubao-Seedance-1.5-pro
ARK_VIDEO_PRIMARY_RATE_LIMIT=5并发

# ---------------------------------------------------------------------
# 可选：Embedding 服务（用于素材语义搜索；默认走本地 Ollama）
# ---------------------------------------------------------------------
# EMBEDDING_API_URL=http://localhost:11434/api/embeddings

# ---------------------------------------------------------------------
# 以下变量当前代码尚未读取（V1 阶段会接入）
# ---------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379
# JWT_SECRET=your-jwt-secret-key
# JWT_EXPIRES_IN=7d
# OSS_ACCESS_KEY=
# OSS_SECRET_KEY=
# OSS_BUCKET=vidforge-assets
# OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
