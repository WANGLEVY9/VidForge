{
  "name": "@vidforge/backend",
  "private": true,
  "version": "1.0.0",
  "description": "VidForge backend API service",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "migration:show": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:show",
    "migration:run": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:run",
    "migration:revert": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:revert",
    "test": "node ../../scripts/run-backend-tests.mjs",
    "lint": "eslint src --ext ts --report-unused-disable-directives --max-warnings 400",
    "lint:fix": "eslint src --ext ts --fix"
  },
  "dependencies": {
    "@langchain/core": "^1.1.0",
    "@langchain/langgraph": "^1.3.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^10.2.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.1.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/swagger": "^7.1.0",
    "@nestjs/throttler": "^6.2.1",
    "@nestjs/typeorm": "^10.0.0",
    "@nestjs/websockets": "^10.4.22",
    "ali-oss": "^6.23.0",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "fluent-ffmpeg": "^2.1.2",
    "langchain": "^1.4.0",
    "multer": "^2.2.0",
    "pg": "^8.11.3",
    "redis": "^5.0.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "typeorm": "^0.3.31",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.17",
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.3.1",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "overrides": {
    "uuid": "^9.0.0"
  }
}
