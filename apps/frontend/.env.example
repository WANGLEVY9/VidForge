# VidForge Frontend 环境变量样例（请复制为 .env.local 后填入真实值）
# 部署到 Vercel 时，把下面变量加到 Project Settings → Environment Variables

# 后端 API 地址（不要带末尾 /）
VITE_API_BASE_URL=http://localhost:3001

# 仅在受控演示部署启用。Vite 变量会进入浏览器产物，不得填写私人账号凭证。
VITE_ENABLE_DEMO_LOGIN=false
# VITE_DEMO_USER_EMAIL=demo@vidforge.app
# VITE_DEMO_USER_PASSWORD=public-demo-only-password

# WebSocket 地址（缺省时回退到 VITE_API_BASE_URL）
# VITE_WS_URL=http://localhost:3001
